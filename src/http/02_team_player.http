#### 일반 선수 생성
// @no-cookie-jar
POST http://127.0.0.1:8080/api/v1/admin/auth/sign_in
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

{
  "providerId": "3",
  "providerType": "TEST"
}
> {%
    client.global.set("SESSION_COOKIE_3", response.headers.valueOf("Set-Cookie"));
%}

#### 입단 신청
POST http://127.0.0.1:8080/api/v1/clubs/{{CLUB_ID}}/resume
Cookie: {{SESSION_COOKIE_3}}
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 2
X-DEVICE-INFO: web

{
  "profileImage": "https://cataas.com/cat",
  "birth": "1999-09-11",
  "height": "170",
  "weight": "79",
  "name": "김우직",
  "email": "woozik@example.com",
  "address": "서울특별시 도봉구 다뽕로 123",
  "phone": "010-1234-5670",
  "emergencyContactPhone": "010-0765-4321",
  "nationality": "KOR",
  "preferredPosition": [
    "CB"
  ],
  "dominantFoot": "RIGHT",
  "advantages": "스피드 우수, 수비 우수",
  "disadvantages": "공격시 위치선정 보완 필요"
}
> {%
    client.global.set("RESUME_ID_2", response.body.id);
%}

#### 계약 - 대표
POST http://127.0.0.1:8080/api/v1/clubs/{{CLUB_ID}}/contract
Cookie: {{SESSION_COOKIE}}
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

{
  "resumeId": "{{RESUME_ID_2}}",
  "agree": true
}
> {%
    client.global.set("CONTRACT_ID_2", response.body.id);
%}


#### 계약 - 개인
POST http://127.0.0.1:8080/api/v1/clubs/{{CLUB_ID}}/contract/sign
Cookie: {{SESSION_COOKIE_3}}
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

{
  "contractId": "{{CONTRACT_ID_2}}",
  "agree": true
}
