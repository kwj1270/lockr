### Step 1 — 로그인 (admin → FC 강남 회장 권한 자동 매핑)
# @no-cookie-jar
POST http://127.0.0.1:8080/api/v1/auth/sign_in/admin
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-NAME: woozi's local
X-DEVICE-OS: mac-os

{
  "id": "admin",
  "password": "test1234"
}
> {%
    client.global.set("SESSION_COOKIE", response.headers.valueOf("Set-Cookie"));
%}


### Step 2 — 시나리오 변수 (seed 기준: FC 강남)
# fee_records는 정책 설정 시 자동 생성되지 않는다 — markUnpaid/markPaid 등
# 개별 멤버 처리 호출 시점에 FeeRecord.create()로 생성된다.
# 따라서 미납 알림(Step 7) 전에 테스트용 미납자 record를 명시적으로 만들어야 한다.
@clubId = 01HXC00000000000000000001
@year = 2026
@month = 4
# FC 강남 일반 멤버 2명 (seed_data.sql)
@memberA = 01HXM00000000000000000005
@memberB = 01HXM00000000000000000006


### Step 3 — 회비 정책 설정 (월 10,000원, 매월 10일까지)
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-policies
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{
  "amount": 10000,
  "dueDay": 10,
  "bankName": "토스뱅크",
  "accountNumber": "1000-1234-5678",
  "accountHolder": "FC 강남 회비"
}


### Step 4 — 정책 확인
GET http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-policies
Cookie: {{SESSION_COOKIE}}


### Step 5 — 미납자 record 생성 1 (memberA)
# FeeRecord.create()로 신규 record 생성, status=UNPAID
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/{{memberA}}/unpaid
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{
  "year": {{year}},
  "month": {{month}}
}


### Step 6 — 미납자 record 생성 2 (memberB)
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/{{memberB}}/unpaid
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{
  "year": {{year}},
  "month": {{month}}
}


### Step 7 — 회비 기록 조회 (UNPAID 2건 확인)
GET http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records?year={{year}}&month={{month}}
Cookie: {{SESSION_COOKIE}}

> {%
    if (response.body.records && response.body.records.length > 0) {
        client.log("총 " + response.body.records.length + "건 records — paidCount=" + response.body.paidCount);
    } else {
        client.log("⚠️  records 비어있음 — Step 5/6 실행 여부 확인");
    }
%}


### Step 8 — 🔔 미납 알림 트리거 (Outbox/Inbox 핵심)
# UnpaidFeeNotifiedEvent 가 IntegrationDomainEvent로 발행됨.
# 흐름: FeeService.notifyUnpaid()
#   → unpaidMemberIds 수집 (UNPAID 상태만, DEFERRED 자동 제외)
#   → FeeNotification.init() (UnpaidFeeNotifiedEvent addEvent)
#   → JOOQFeeNotificationRepository.save() → publish(domainEventPublisher)
#   → OutboxDomainEventPublisher → domain_event_outbox INSERT
#   → OutboxProcessor 폴링 (100ms) → ApplicationEventPublisher.publishEvent()
#   → FeeNotificationEventConsumer.onEvent() → handle() → inbox 가드 → doHandle()
#   → CreateFeeUnpaidNotificationUseCase.create() (FCM 푸시)
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/notify
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{
  "year": {{year}},
  "month": {{month}}
}


### Step 9 — (선택) memberA paid 처리
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/{{memberA}}/paid
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{
  "year": {{year}},
  "month": {{month}}
}


### Step 10 — (선택) memberB 유예 처리
# DEFERRED 상태는 다음 notify 호출 시 자동 제외됨
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/{{memberB}}/defer
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{
  "year": {{year}},
  "month": {{month}}
}


### Step 11 — (선택) 다시 notify (UNPAID 0명 → 이벤트 미발행)
# Step 9에서 A는 PAID, Step 10에서 B는 DEFERRED → unpaidMemberIds 비어있음
# → FeeService.notifyUnpaid() 의 early return → outbox INSERT 없음
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/notify
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{
  "year": {{year}},
  "month": {{month}}
}


###
# 🔍 Outbox/Inbox 관측 가이드
#
# 1. 서버 로그
#    - 기동: "OutboxEventTypeRegistry initialized: 1 event types registered."
#    - Step 8 실행 후: OutboxProcessor 폴링 → publish → markProcessed (정상 시 무로그)
#    - Chaos 활성: 랜덤 latency/exception → retry 로그 → MAX_RETRY 도달 시 stuck 진입
#    - 5분 주기 monitorStuck() ERROR (stuck > 0)
#
# 2. DB 직접 확인 (docker exec mysql ...)
#    SELECT event_id, event_type, processed, retry_count, created_at
#    FROM domain_event_outbox
#    WHERE event_type = 'com.official.lockr.club.fee.unpaid_notified'
#    ORDER BY created_at DESC LIMIT 5;
#
#    SELECT event_id, consumer_name, processed_at
#    FROM domain_event_inbox
#    WHERE consumer_name = 'fee.unpaid_notification'
#    ORDER BY processed_at DESC LIMIT 5;
#
# 3. Chaos Monkey 런타임 토글 (관측 endpoint = 18080 / base-path = /prefer)
#    GET  http://127.0.0.1:18080/prefer/chaosmonkey/status
#    POST http://127.0.0.1:18080/prefer/chaosmonkey/disable
#    POST http://127.0.0.1:18080/prefer/chaosmonkey/enable
#
# 4. 비즈니스 규칙 (FeeNotification.notifyUnpaid 도메인 규칙)
#    - 같은 (year, month)에 대한 미납 알림은 최대 3회까지만 발송 가능
#    - 4번째 호출 시 IllegalStateException → API 5xx
#    - DEFERRED 상태 멤버는 자동으로 발송 대상 제외
#    - UNPAID 0명이면 FeeNotification 자체를 만들지 않음 (early return) → outbox INSERT 없음
