### Step 1 — 로그인 (admin)
POST http://127.0.0.1:8080/api/v1/auth/sign_in/admin
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-NAME: woozi's local
X-DEVICE-OS: mac-os

{
  "id": "admin",
  "password": "test1234"
}
> {%
    client.global.set("SESSION_COOKIE", response.headers.valueOf("Set-Cookie"));
%}


### Step 2 — 시나리오 변수 (seed 기준: FC 강남)
# clubId : seed_data.sql의 FC 강남 클럽 ID
# year/month: 회비 청구 대상 연·월
@clubId = 01HXC00000000000000000001
@year = 2026
@month = 4


### Step 3 — 회비 정책 설정 (월 10,000원, 매월 10일까지 납부)
# 정책 등록 시점에 해당 월의 fee_records가 멤버 수만큼 자동 생성된다 (모두 UNPAID 상태).
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-policies
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{
  "amount": 10000,
  "dueDay": 10,
  "bankName": "토스뱅크",
  "accountNumber": "1000-1234-5678",
  "accountHolder": "FC 강남 회비"
}


### Step 4 — 정책 확인
GET http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-policies
Cookie: {{SESSION_COOKIE}}


### Step 5 — 회비 기록 조회 (자동 생성된 records 확인)
# 응답의 records[0].memberId 를 자동으로 변수에 저장 — Step 6에서 paid 처리 대상으로 사용.
GET http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records?year={{year}}&month={{month}}
Cookie: {{SESSION_COOKIE}}

> {%
    if (response.body.records && response.body.records.length > 0) {
        client.global.set("memberId", response.body.records[0].memberId);
        client.log("선택된 memberId = " + response.body.records[0].memberId);
    } else {
        client.log("⚠️  records 비어있음 — 정책 설정(Step 3) 또는 클럽 멤버십 확인 필요");
    }
%}


### Step 6 — 한 명만 납부 처리 (나머지는 미납 상태로 남음)
# Step 5에서 추출된 첫 멤버를 paid 처리 → Step 7 알림 발송 시 이 멤버는 제외되는 것을 검증.
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/{{memberId}}/paid
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{}


### Step 7 — 🔔 미납 알림 트리거 (Outbox/Inbox 핵심 시나리오)
# UnpaidFeeNotifiedEvent 가 IntegrationDomainEvent로 발행됨.
# 흐름: FeeService.notifyUnpaid()
#   → FeeNotification.init() (UnpaidFeeNotifiedEvent addEvent)
#   → JOOQFeeNotificationRepository.save() → publish(domainEventPublisher)
#   → OutboxDomainEventPublisher → domain_event_outbox INSERT (Aggregate save 트랜잭션)
#   → OutboxProcessor 폴링 (100ms 주기)
#   → ApplicationEventPublisher.publishEvent(event)
#   → FeeNotificationEventConsumer.onEvent() → handle()
#   → IdempotentEventHandler: inbox INSERT(idempotent) → doHandle()
#   → CreateFeeUnpaidNotificationUseCase.create() (FCM 푸시)
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/notify
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{
  "year": {{year}},
  "month": {{month}}
}


### Step 8 — (선택) 특정 멤버 유예 처리
# DEFERRED 상태 멤버는 notifyUnpaid 발송 대상에서 자동 제외.
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/{{memberId}}/defer
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{}


### Step 9 — (선택) 특정 멤버 미납으로 되돌리기
POST http://127.0.0.1:8080/api/v1/clubs/{{clubId}}/fee-records/{{memberId}}/unpaid
Content-Type: application/json
Cookie: {{SESSION_COOKIE}}

{}


###
# 🔍 Outbox/Inbox 관측 가이드
#
# 1. 서버 로그
#    - 기동: "OutboxEventTypeRegistry initialized: 1 event types registered."
#    - 정상 발행: OutboxProcessor 폴링 후 publish/markProcessed 정상 동작 (별도 ERROR 없음)
#    - 카오스 활성 시: 랜덤 latency/exception → retry 로그 → MAX_RETRY 도달 시 stuck 진입
#    - 5분 주기 monitorStuck() ERROR 로그 (stuck > 0)
#
# 2. DB 직접 확인
#    SELECT event_id, event_type, processed, retry_count, created_at
#    FROM domain_event_outbox
#    WHERE event_type = 'com.official.lockr.club.fee.unpaid_notified'
#    ORDER BY created_at DESC LIMIT 5;
#
#    SELECT event_id, consumer_name, processed_at
#    FROM domain_event_inbox
#    WHERE consumer_name = 'fee.unpaid_notification'
#    ORDER BY processed_at DESC LIMIT 5;
#
# 3. Chaos Monkey 런타임 토글 (관측 endpoint = 18080 / base-path = /prefer)
#    GET  http://127.0.0.1:18080/prefer/chaosmonkey/status
#    POST http://127.0.0.1:18080/prefer/chaosmonkey/disable
#    POST http://127.0.0.1:18080/prefer/chaosmonkey/enable
#
# 4. 비즈니스 규칙 (FeeNotification.notifyUnpaid 도메인 규칙)
#    - 같은 (year, month)에 대한 미납 알림은 최대 3회까지만 발송 가능
#    - 4번째 호출 시 IllegalStateException 발생 → API 400/500 응답
#    - DEFERRED 상태 멤버는 자동으로 발송 대상 제외
