> {%
    client.global.set("OTHER_RESUME_ID_2", response.body.id);
%}

#### 계약 - 대표
POST http://127.0.0.1:8080/api/v1/clubs/{{OTHER_CLUB_ID}}/contract
Cookie: {{OTHER_SESSION_COOKIE}}
