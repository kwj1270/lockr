#### 로그인
POST http://127.0.0.1:8080/api/v1/admin/auth/sign_in
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

{
  "providerId": "100",
  "providerType": "TEST"
}
> {%
    client.global.set("OTHER_SESSION_COOKIE", response.headers.valueOf("Set-Cookie"));
%}

#### 팀 창단
POST http://127.0.0.1:8080/api/v1/clubs
Cookie: {{OTHER_SESSION_COOKIE}}
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

{
  "name": "other club",
  "description": "other club"
}
> {%
    client.global.set("OTHER_CLUB_ID", response.body.id);
%}

#### 일반 선수 생성
// @no-cookie-jar
POST http://127.0.0.1:8080/api/v1/admin/auth/sign_in
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

{
  "providerId": "102",
  "providerType": "TEST"
}
> {%
    client.global.set("OTHER_SESSION_COOKIE_2", response.headers.valueOf("Set-Cookie"));
%}

#### 입단 신청
POST http://127.0.0.1:8080/api/v1/clubs/{{OTHER_CLUB_ID}}/resume
Cookie: {{OTHER_SESSION_COOKIE_2}}
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 2
X-DEVICE-INFO: web

{
  "profileImage": "https://cataas.com/cat",
  "birth": "1998-07-15",
  "height": "180",
  "weight": "75",
  "name": "홍길동",
  "email": "gildong@example.com",
  "address": "서울특별시 강남구 테헤란로 123",
  "phone": "010-1234-5678",
  "emergencyContactPhone": "010-8765-4321",
  "nationality": "KOR",
  "preferredPosition": [
    "CF",
    "RW"
  ],
  "dominantFoot": "RIGHT",
  "advantages": "스피드와 결정력 우수",
  "disadvantages": "수비 시 위치선정 보완 필요"
}
> {%
    client.global.set("OTHER_RESUME_ID", response.body.id);
%}

#### 계약 - 대표
POST http://127.0.0.1:8080/api/v1/clubs/{{OTHER_CLUB_ID}}/contract
Cookie: {{OTHER_SESSION_COOKIE}}
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

{
  "resumeId": "{{OTHER_RESUME_ID}}",
  "agree": true
}
> {%
    client.global.set("OTHER_CONTRACT_ID", response.body.id);
%}


#### 계약 - 개인
POST http://127.0.0.1:8080/api/v1/clubs/{{OTHER_CLUB_ID}}/contract/sign
Cookie: {{OTHER_SESSION_COOKIE_2}}
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

{
  "contractId": "{{OTHER_CONTRACT_ID}}",
  "agree": true
}

### 팀 조회(일단 스쿼드로 조회)
GET http://127.0.0.1:8080/api/v1/clubs/{{OTHER_CLUB_ID}}/squads
Cookie: {{OTHER_SESSION_COOKIE}}
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

> {%
    client.global.set("OTHER_SQUAD_ID", response.body.id);
    client.global.set("OTHER_CLUB_ID", response.body.clubId);
    client.global.set("OTHER_PLAYER_ID_2", response.body.squadPlayers[1].memberId);
%}


#### 매니저 임명
POST http://127.0.0.1:8080/api/v1/clubs/{{OTHER_CLUB_ID}}/manager
Cookie: {{OTHER_SESSION_COOKIE}}
Content-Type: application/json
Authorization: test
X-DEVICE-ID: 1
X-DEVICE-INFO: web

{
  "targetMemberId": "{{OTHER_PLAYER_ID_2}}"
}

