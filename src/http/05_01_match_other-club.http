  "email": "woozik@example.com",
  "address": "서울특별시 도봉구 다뽕로 123",
  "phone": "010-1234-5670",
  "emergencyContactPhone": "010-0765-4321",
  "nationality": "KOR",
  "preferredPosition": [
    "CB"
  ],
