{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-domain-purity.sh",
            "timeout": 5,
            "statusMessage": "DDD 레이어 순수성 검증 중..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/suggest-adr.sh",
            "timeout": 5,
            "statusMessage": "ADR 필요 여부 확인 중..."
          }
        ]
      }
    ]
  }
}