{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-domain-purity.sh",
            "timeout": 5,
            "statusMessage": "DDD 레이어 순수성 검증 중..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/suggest-adr.sh",
            "timeout": 5,
            "statusMessage": "ADR 필요 여부 확인 중..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/suggest-doc-regen.sh",
            "timeout": 5,
            "statusMessage": "도메인 문서 갱신 필요 여부 확인 중..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/suggest-seed-update.sh",
            "timeout": 5,
            "statusMessage": "Seed 데이터 동기화 확인 중..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-feature-drift.sh",
            "timeout": 5,
            "statusMessage": "Cucumber feature 동기화 확인 중..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-claudemd-drift.sh",
            "timeout": 5,
            "statusMessage": "도메인 CLAUDE.md 동기화 확인 중..."
          }
        ]
      }
    ]
  }
}